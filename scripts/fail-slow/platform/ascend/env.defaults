# Ascend / 华为 AIS — Fail-Slow 默认环境（草稿，接入后按镜像改）
# 用法：在 launcher 里 source，或由 install_env 拷到 pod。

# --- 可见设备（名称待实测确认）---
# export ASCEND_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
# 部分栈仍认：
# export CUDA_VISIBLE_DEVICES=   # 建议 unset，避免和 NPU 抢语义

# --- HCCL / 分布式 ---
# export HCCL_CONNECT_TIMEOUT=1800
# export HCCL_EXEC_TIMEOUT=0
# export HCCL_WHITELIST_DISABLE=1
# export HCCL_IF_IP=              # 或 HCCL_SOCKET_IFNAME=
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-eth0}"

# --- Probing（包名/特性待定；先按 0.2.5 能力假设）---
# export PROBING=2
# export PROBING_GPU=on
# export PROBING_GPU_SAMPLE_MS=1000
# 昇腾上 torch profiling 是否 SIGSEGV：smoke 后决定默认关/开
# unset PROBING_TORCH_PROFILING

# --- Flight Recorder（C5；变量名待对照 Ascend PyTorch）---
# export TORCH_HCCL_TRACE_BUFFER_SIZE=1048576
# 或仍用 TORCH_NCCL_* 若栈兼容：
export TORCH_NCCL_TRACE_BUFFER_SIZE="${TORCH_NCCL_TRACE_BUFFER_SIZE:-1048576}"
export TORCH_NCCL_DUMP_ON_TIMEOUT="${TORCH_NCCL_DUMP_ON_TIMEOUT:-1}"

# --- Baseline preload 路径（pod 内）---
export FS_GREYHOUND_SO="${FS_GREYHOUND_SO:-/workspace/probe-bundle/greyhound/libhcclprobe.so}"
export FS_XPUTIMER_SO="${FS_XPUTIMER_SO:-/workspace/probe-bundle/xputimer/libxpu_timer_ascend.so}"

# --- 结果根（本机编排时由 LOCAL_RESULT_ROOT 覆盖）---
# LOCAL_RESULT_ROOT=.../results/ascend-ais/$RUN_ID
